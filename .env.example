# cisco-smart-licensing-mcp — example environment file.
#
# Copy to `.env` for local development. NEVER commit a real `.env`.
# All values below are placeholders. The wrapper scripts/run-cursor.sh sources
# this file into the process environment before exec'ing the binary; the server
# itself does NOT auto-load .env files.

# === OAuth2 client credentials (from the Cisco IT API Portal) =============
# Get these from the Cisco licensing API portal (NOT apiconsole.cisco.com):
#   https://it-developer.cisco.com/auth/customer-assets/licensing/apis/latest/
# Two-step process: (1) create an Application (Type = API) to generate the
# Client ID/Secret, then (2) use "Request Access" to associate the Software APIs
# (prod) with that app. Both are required — without step (2) calls return
# 403 "Invalid Client". See ACCESS_GUIDE.md for the full step-by-step.
# SL_CLIENT_ID=your-client-id
# SL_CLIENT_SECRET=your-client-secret

# === OAuth2 token endpoint ================================================
# Default is the current Cisco IdP endpoint (used by newly registered API
# Console apps). If your app was minted on the legacy IdP, switch to
# https://cloudsso.cisco.com/as/token.oauth2 instead.
# SL_TOKEN_URL=https://id.cisco.com/oauth2/default/v1/token

# === API surface ==========================================================
# Cisco "Software APIs" base URL (cloud CSSM), from the official OpenAPI spec.
# Override only if Cisco documents a different host/version.
# SL_BASE_URL=https://apx.cisco.com/v1/software/apis

# Optional default Smart Account domain so tools don't need it every call.
# SL_SMART_ACCOUNT_DOMAIN=example.cisco.com

# Optional default CCO user id for sl_list_smart_accounts (userId query param).
# SL_USER_ID=<your-cco-id>

# Allow token/API hosts outside *.cisco.com (SSRF guard). Keep unset/false.
# SL_ALLOW_CUSTOM_HOST=false

# === Operational controls =================================================
# Writes are NOT registered by default; this server is read-only for inventory.
# SL_ENABLE_WRITES=false

# Optional: write a redacted JSON snapshot of each successful tool call.
# SL_EVIDENCE_DIR=/tmp/sl-evidence

# === HTTP client tuning ===================================================
# HTTP_TIMEOUT_SECONDS=30
# HTTP_MAX_RETRIES=3

# === Token cache tuning ===================================================
# Refresh the access token this many seconds before it expires.
# SL_TOKEN_REFRESH_SKEW_SECONDS=60

# === Logging / transport ==================================================
# LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL
# MCP_TRANSPORT=stdio     # stdio (recommended) | http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8765
